{
    "name": "jeffersongoncalves/obsidian-notes-cli",
    "description": "CLI that writes structured Markdown notes generated by Claude Code into an Obsidian vault.",
    "keywords": ["cli", "obsidian", "markdown", "notes", "claude-code", "laravel-zero"],
    "homepage": "https://github.com/jeffersongoncalves/obsidian-notes-cli",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Goncalves",
            "email": "jeffersongoncalves@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.15",
        "jeffersongoncalves/laravel-zero-self-update": "^1.0",
        "laravel-zero/framework": "^12.0",
        "laravel/pint": "^1.25",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8|^4.1",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": ["php obsidian-notes app:build obsidian-notes"],
        "lint": "./vendor/bin/pint",
        "test:lint": "./vendor/bin/pint --test",
        "test:unit": "./vendor/bin/pest",
        "test:types": "./vendor/bin/phpstan analyse --memory-limit=256M",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=256M",
        "phpstan-baseline": "./vendor/bin/phpstan analyse --generate-baseline --memory-limit=256M",
        "test": [
            "@test:unit",
            "@test:lint"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["builds/obsidian-notes"]
}
